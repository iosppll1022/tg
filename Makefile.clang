# 无 Theos 时：用 iOS SDK + clang 编出 arm64 dylib
#
# macOS / Xcode：
#   make -f Makefile.clang \
#     SDK="$(xcrun --sdk iphoneos --show-sdk-path)" \
#     CC="$(xcrun --sdk iphoneos -f clang)"
#
# Linux + Theos 工具链：
#   make -f Makefile.clang \
#     SDK=$THEOS/sdks/iPhoneOS16.5.sdk \
#     CC=$THEOS/toolchain/linux/iphone/bin/clang

SDK ?=
CC ?= clang
MIN_IOS ?= 14.0
TARGET_TRIPLE ?= arm64-apple-ios$(MIN_IOS)

CFLAGS = -target $(TARGET_TRIPLE) -fobjc-arc -fPIC -O2 -Wall \
	-isysroot $(SDK) -Ivendor/fishhook
LDFLAGS = -target $(TARGET_TRIPLE) -isysroot $(SDK) \
	-dynamiclib -framework Foundation \
	-install_name @rpath/TelegramAntiRecall.dylib \
	-compatibility_version 1 -current_version 1

OBJS = build/AntiRecall.o build/fishhook.o
OUT = build/TelegramAntiRecall.dylib

.PHONY: all clean
all: $(OUT)

build:
	mkdir -p build

build/AntiRecall.o: src/AntiRecall.m | build
	$(CC) $(CFLAGS) -c $< -o $@

build/fishhook.o: vendor/fishhook/fishhook.c | build
	$(CC) $(CFLAGS) -c $< -o $@

$(OUT): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)
	@echo "OK -> $(OUT)"
	@ls -la $(OUT)

clean:
	rm -rf build
